# =============================================================================
# SRI KRISHNA SWACCH AAHARAM — BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env before starting the backend application:
#   cp .env.example .env
# Fill in your actual credentials. NEVER commit .env to version control!
# =============================================================================

# Server Environment
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
API_VERSION=v1

# Frontend CORS Origin
CORS_ORIGINS=http://localhost:5173

# Database — PostgreSQL (Prisma)
# Replace with your local or production database credentials:
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/vishkaraa_db?schema=public"

# Authentication — JWT
# Generate a cryptographically secure random secret (min 32 characters):
JWT_SECRET=replace_with_a_secure_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret_min_32_characters
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Audit Logging
AUDIT_LOG_ENABLED=true

# Payment Gateway — Razorpay (Optional in development)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloud Storage — AWS S3 (Optional for product media)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
