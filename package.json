{
  "name": "sri-krishna-swacch-aaharam-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sri Krishna Swacch Aaharam — NestJS Backend API & Database Service",
  "type": "module",
  "scripts": {
    "postinstall": "pnpm --filter @vishkaraa/api run db:generate",
    "dev": "pnpm --filter @vishkaraa/api run dev",
    "start": "pnpm --filter @vishkaraa/api run start",
    "start:prod": "pnpm --filter @vishkaraa/api run start:prod",
    "build": "pnpm --filter @vishkaraa/types run build && pnpm --filter @vishkaraa/shared run build && pnpm --filter @vishkaraa/config run build && pnpm --filter @vishkaraa/api run build",
    "test": "pnpm --filter @vishkaraa/api run test",
    "test:e2e": "pnpm --filter @vishkaraa/api run test:e2e",
    "db:generate": "pnpm --filter @vishkaraa/api run db:generate",
    "db:migrate": "pnpm --filter @vishkaraa/api run db:migrate",
    "db:migrate:prod": "pnpm --filter @vishkaraa/api run db:migrate:prod",
    "db:seed": "pnpm --filter @vishkaraa/api run db:seed",
    "db:studio": "pnpm --filter @vishkaraa/api run db:studio",
    "lint": "pnpm --filter @vishkaraa/api run lint",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
